# Google AI Studio API key.
GOOGLE_API_KEY=replace_with_google_ai_api_key

# Use the new sb_secret_ key, not the legacy service_role API key.
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_key

# Use the new sb_publishable_ key, not the legacy anon API key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_key

# Site URL used by the app, for example http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key

# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
